MONGODB_HOSTS=10.17.159.232:27017,10.17.159.228:27017,10.17.158.254:27017
MONGODB_USERNAME=dml_v4_survey_user
MONGODB_PASSWORD=replace-with-raw-password
MONGODB_DATABASE=dml_v4_survey
MONGODB_AUTH_SOURCE=dml_v4_survey
MONGODB_REPLICA_SET=rs0
MONGODB_WRITE_CONCERN=1
MONGODB_SERVER_SELECTION_TIMEOUT_MS=3000
WEB_PORT=8080
ADMIN_USERNAME=admin
# 使用 README 中的命令生成，不要填写明文密码。
ADMIN_PASSWORD_HASH='$argon2id$v=19$m=65536,t=3,p=4$REPLACE_ME'
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters
# 仅在 HTTPS 部署时设为 true。
ADMIN_SECURE_COOKIE=false

# 外部系统登录；两个密钥均应使用独立的随机值。
EXTERNAL_SSO_SHARED_SECRET=replace-with-another-32-character-random-secret
USER_SESSION_SECRET=replace-with-a-user-session-random-secret
EXTERNAL_SSO_ISSUER=dml-demo-external
EXTERNAL_SSO_AUDIENCE=dml-survey
EXTERNAL_PORTAL_URL=http://127.0.0.1:9000
# 仅在 HTTPS 部署时设为 true。
USER_SECURE_COOKIE=false

LOG_LEVEL=INFO
